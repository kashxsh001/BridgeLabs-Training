    class Circle
    {
        //public double radius { get; set; }
        private double radius;
         public double Radius
        {
            get
            {
                return radius;
            }

            set
            {
                radius = value;
            }
        }
        public double area()
        {
            return 3.14 * radius * radius;
        }
        public double Circumference()
        {
            return 2 * 3.14 * radius;
        }

    }


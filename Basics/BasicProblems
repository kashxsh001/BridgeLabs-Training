using System;
class Basics
{
    static void Add()
    {
        int num1 = int.Parse(Console.ReadLine()!);
        int num2 = int.Parse(Console.ReadLine()!);
        Console.WriteLine($"Addition of {num1} and {num2} is {num1 + num2}");
    }

    static void Volume()
    {
        double radius = double.Parse(Console.ReadLine()!);
        double height = double.Parse(Console.ReadLine()!);
        double pi = 3.14;
        double volume = pi * Math.Pow(radius, 2) * height; ;
        Console.WriteLine($"The Volume ofCylinder is : {volume} ");

    }

    static void Average()
    {
        int num1 = int.Parse(Console.ReadLine()!);
        int num2 = int.Parse(Console.ReadLine()!);
        int num3 = int.Parse(Console.ReadLine()!);
        int sum = num1 + num2 + num3;
        int avg = sum / 3;
        Console.WriteLine($"The average of {num1}, {num2} and {num3} is {avg}");
    }

    static void KilometerToMiles()
    {
        double km = Convert.ToDouble(Console.ReadLine()!);
        double miles = km * 0.621;
        Console.WriteLine(km+"km is equal to "+miles+"miles");
    }

    static void PowCalculation(int baseNumber,int exp)
    {
        double result = Math.Pow(baseNumber, exp);

        Console.WriteLine(baseNumber + " raised to the power "
            + exp + " is " + result);

    }

    static void Main(String[] args)
    {
        Add();
        Volume();
        Average();
        KilometerToMiles();
        PowCalculation(2, 3);
    }
}

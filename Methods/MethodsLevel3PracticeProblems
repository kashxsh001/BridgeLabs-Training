    static double FindDistance(double x1, double y1, double x2, double y2)
    {
        return Math.Sqrt(Math.Pow(x2 - x1, 2) + Math.Pow(y2 - y1, 2));
    }

    static double[] FindLineEquation(double x1, double y1, double x2, double y2)
    {
        double m = (y2 - y1) / (x2 - x1);
        double b = y1 - m * x1;

        return new double[] { m, b };
    }
    static bool IsCollinearSlope(double x1, double y1, double x2, double y2, double x3, double y3)
    {
        double slopeAB = (y2 - y1) / (x2 - x1);
        double slopeBC = (y3 - y2) / (x3 - x2);
        double slopeAC = (y3 - y1) / (x3 - x1);

        return slopeAB == slopeBC && slopeBC == slopeAC;
    }

    static bool IsCollinearArea(double x1, double y1, double x2, double y2, double x3, double y3)
    {
        double area = 0.5 *
        (
            x1 * (y2 - y3)
          + x2 * (y3 - y1)
          + x3 * (y1 - y2)
        );

        return area == 0;
    }
    static double[,] GenerateEmployeeData()
    {
        Random random = new Random();

        double[,] employee = new double[10, 2];

        for (int i = 0; i < 10; i++)
        {
            employee[i, 0] = random.Next(10000, 100000); // salary
            employee[i, 1] = random.Next(1, 11);         // years
        }

        return employee;
    }

    static double[,] CalculateBonus(double[,] employee)
    {
        double[,] result = new double[10, 2];

        for (int i = 0; i < 10; i++)
        {
            double salary = employee[i, 0];
            double years = employee[i, 1];

            double bonus = years > 5 ? salary * 0.05 : salary * 0.02;

            result[i, 0] = bonus;
            result[i, 1] = salary + bonus;
        }

        return result;
    }


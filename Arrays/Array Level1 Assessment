    static void CanVote(int[] ages)
    {
        for(int i = 0;i< ages.Length; i++)
        {
            int age = ages[i];
            if (age < 0)
            {
                Console.WriteLine("Invalid age");
            }
            else if (age >= 18)
            {
                Console.WriteLine($"The student with the {age} can vote.");
            }
            else
            {
                Console.WriteLine($"The student with the {age} cannot vote.");
            }
        }
        
        
    }

    static void IsPositive(int[] numbers)
    {
        for(int i = 0; i < numbers.Length; i++)
        {
            int num = numbers[i];
            if (num > 0)
            {
                if (num % 2 == 0)
                {
                    Console.WriteLine("Number is Positive and Even");
                }
                else
                {
                    Console.WriteLine("Number is Positive and Odd");
                }
            }
            else if (num < 0)
            {
                Console.WriteLine("Negative");
            }
            else
            {
                Console.WriteLine("Zero");
            }
        }
        int first = numbers[0];
        int last = numbers[numbers.Length - 1];

        if (first > last)
        {
            Console.WriteLine("First is greater");
        }
        else if(last > first)
        {
            Console.WriteLine("Last is greater");
        }
        else
        {
            Console.WriteLine("Both are Equal");
        }

    }

    static int Sum(int[] numbers)
    {
        int sum = 0;
        int index = 0;
        while (index<numbers.Length)
        {
            int num = int.Parse(Console.ReadLine()!);
            if (num <= 0 ) break;
            numbers[index++] = num;
        }
        foreach(int num in numbers)
        {
            sum += num;
        }

        return sum;

    }

    static int[] Factors(int num,ref int index)
    {
        int[] factors = new int[10];
        for(int i = 1; i <= num; i++)
        {
            if (num % i == 0)
            {
                factors[index++] = i;
            }
        }

        return factors;

    }

    static double MeanHeight(double[] heights)
    {
        double sum = 0;

        foreach(double num in heights)
        {
            sum += num;
        }

        return sum / heights.Length;
    }

    static string[] FizzBuzz(int num)
    {
        string[] arr = new string[num];
        int index = 0;
        if (num > 0)
        {
            for(int i = 0; i < num; i++)
            {
                if (i % 3 == 0 && i % 5 == 0)
                {
                    arr[index++] = "FizzBuzz";
                }
                else if (i % 5 == 0)
                {
                    arr[index++] = "Buzz";
                }
                else if(i%3==0)
                {
                    arr[index++] = "Fizz";
                }
                else
                {
                    arr[index++] = i.ToString();
                }
            }
        }

        return arr;
    }
